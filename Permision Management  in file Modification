<h1> ***************** PERMISSION THE COMMAND *************

chmod ugo+rwx fileNAME  = file permission full 777

chmod ugo+rwx fileName  =  file permission all zero

chmod 775 fileNAME  =  file permissin in allocate


<h1> ******************* FILE PERMISSION ARE THE OWNERSHIP CHANGE COMMAND *************

chown username filename  =  file of the user owner are change

chown user:groupname  =  file of the user and group are change

chown :groupname filename  =  file of the group owner change

chgrp groupname filename  =  file of the group owner change 
