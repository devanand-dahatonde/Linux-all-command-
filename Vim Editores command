<h1>  VIM COMMAND EDITOR

i = insert mode

I = Inserts text at the beginning of the current line

V = one by one line select

v = one by one line select

yy = to yanked a line a copy

nyy = to yank number of lines

P = to paste the line above  

p = to paste the line below 

yw = to yank a  copy word

nyw = to yank number of words (ex - 5yw)

dd = to delete the line

ndd = to delete number of lines {ex - 5dd)

dw = to delete word

ndw = to delete number of words

cc = to cut the current line

cw = to cut the current word

ncc = to cut the number of line

ncw = to cut the number of word

u = undo words and line

ctrl + r =  redo undo file are delete

gg = gg press in first line

ngg = send curser to number of the line

G = to send curser at the bottom of the line

nG = send curser to number of the line

h = left

j = down

k = up

l = right

H = page at high top of the screen

M = middle of the screen

L = press in page to bottom curser

$ = line in the end

o = line in first word

ctrl v = block select

:set nonu = exit set number

:set nu = set number

:/data name = helight

:nohl = no helight

:w filename = new filename create

:%s/old data/new data/  = data edit 









































